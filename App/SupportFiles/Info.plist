<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>ATSApplicationFontsPath</key>
	<string>.</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIconFile</key>
	<string>MouseFix.tiff</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.nuebling.mac-mouse-fix</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>macmousefix</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>24830</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.utilities</string>
	<key>NSHumanReadableCopyright</key>
	<string>Copyright © 2019-2023 Noah Nuebling (MMF License)</string>
	<key>NSMainStoryboardFile</key>
	<string>Main</string>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<key>SUAllowsAutomaticUpdates</key>
	<false/>
	<key>SUEnableJavaScript</key>
	<string>YES</string>
	<key>SUFeedURL</key>
	<!-- PATCH [dttxorg]: redirected to a local placeholder. Combined with the
	     DISABLE_UPDATES compile flag, this prevents the build from ever
	     talking to the upstream update feed. Defense-in-depth: if anything
	     ever triggers Sparkle (e.g. a leftover "Check for Updates..." menu
	     item), the request stays on localhost. -->
	<string>http://127.0.0.1:0/mac-mouse-fix-disabled/appcast.xml</string>
	<key>SUPublicEDKey</key>
	<!-- PATCH [dttxorg]: cleared so even if a stray appcast is fetched, the
	     EdDSA signature verification will fail and Sparkle will refuse to
	     install anything. The original key is preserved here in the comment
	     below for reference:
	         ZC69ciDfGYN4t3kwRiPc2SC7J4hchv9w+FfVv59r4+U=
	-->
	<string></string>
	<key>UIDesignRequiresCompatibility</key>
	<true/>
</dict>
</plist>
